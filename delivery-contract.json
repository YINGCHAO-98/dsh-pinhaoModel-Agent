{
  "version": 1,
  "editablePaths": ["src/"],
  "protectedPaths": ["tests/", "package.json", "package-lock.json", "pnpm-lock.yaml", "yarn.lock"],
  "requiredPaths": ["tests/"],
  "checks": [
    { "id": "node-tests", "argv": ["node", "--test", "--test-reporter=tap"], "timeoutMs": 60000, "minTests": 1 }
  ],
  "maxRepairs": 2
}
